{
  "genesis_metadata": {
    "blueprint_id": "animatediff",
    "blueprint_version": "2.0",
    "format": "comfyui_api_prompt",
    "purpose": "Turn a still image into a short animated clip using AnimateDiff-Lightning + SD 1.5.",
    "required_placeholders": [
      "INPUT_IMAGE_PATH",
      "PROMPT_TEXT",
      "NEGATIVE_PROMPT_TEXT",
      "OUTPUT_PREFIX"
    ],
    "model_files": {
      "checkpoint": "v1-5-pruned-emaonly.safetensors",
      "animatediff_module": "animatediff_lightning_8step_comfyui.safetensors"
    },
    "node_types_used": [
      "LoadImage",
      "CheckpointLoaderSimple",
      "CLIPTextEncode",
      "ADE_LoadAnimateDiffModel",
      "ADE_ApplyAnimateDiffModel",
      "KSampler",
      "VAEDecode",
      "VHS_VideoCombine"
    ]
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "v1-5-pruned-emaonly.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PROMPT_TEXT",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "NEGATIVE_PROMPT_TEXT",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "ADE_LoadAnimateDiffModel",
    "inputs": {
      "model_name": "animatediff_lightning_8step_comfyui.safetensors"
    }
  },
  "5": {
    "class_type": "ADE_ApplyAnimateDiffModel",
    "inputs": {
      "motion_model": ["4", 0],
      "model": ["1", 0],
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 896,
      "batch_size": 16
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1.5,
      "sampler_name": "euler",
      "scheduler": "sgm_uniform",
      "denoise": 1.0,
      "model": ["5", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["1", 2]
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "OUTPUT_PREFIX",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
